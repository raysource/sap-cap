    "lines": [
      "_schema-version: 3.3.0",
      "ID: demo-node",
      "version: 1.0.0",
      "parameters:",
      "  enable-parallel-deployments: true",
      "  deploy_mode: html5-repo",
      "build-parameters:",
      "  before-all:",
      "    - builder: custom",
      "      commands:",
      "        - npm ci",
      "        - npx cds build --production",
      "modules:",
      "  - name: demo-node-srv",
      "    type: nodejs",
      "    path: gen/srv",
      "    parameters:",
      "      buildpack: nodejs_buildpack",
      "    build-parameters:",
      "      builder: npm-ci",
      "    provides:",
      "      - name: srv-api",
      "        properties:",
      "          srv-url: ${default-url}",
      "    requires:                 # 服务实例：授权 + 数据库",
      "      - name: demo-node-auth",
      "      - name: demo-node-db",
      "  - name: demo-node-db-deployer",
      "    type: hdb",
      "    path: gen/db",
      "    requires:",
      "      - name: demo-node-db",
      "  - name: demo-node",
      "    type: approuter.nodejs",
      "    path: app/router",
      "    parameters: { memory: 256M }",
      "    requires:",
      "      - name: srv-api",
      "        group: destinations",
      "        properties:",
      "          url: ~{srv-url}",
      "          forwardAuthToken: true",
      "      - name: demo-node-auth",
      "resources:",
      "  - name: demo-node-db",
      "    type: com.sap.xs.hdi-container",
      "    parameters:",
      "      service: hana",
      "      service-plan: hdi-shared"
    ]
  },
