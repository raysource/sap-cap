      "{",
      "  \"dependencies\": { \"@sap/cds\": \"^9\" },",
      "  \"devDependencies\": { \"@cap-js/sqlite\": \"^2\", \"@sap/cds-dk\": \"^9\" },",
      "  \"scripts\": {",
      "    \"watch\":  \"cds watch\",",
      "    \"deploy\": \"cds deploy --to sqlite:db.sqlite\",",
      "    \"build\":  \"cds build --production\",",
      "    \"lint:model\": \"cds compile db/schema.cds --to sql\""
    ]
  },
