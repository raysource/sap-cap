    "lines": [
      "@Component",
      "@ServiceName(BookOrderService_.CDS_NAME)",
      "public class BookOrderServiceHandler implements EventHandler {",
      "",
      "  private final PersistenceService db;",
      "",
      "  public BookOrderServiceHandler(PersistenceService db) {",
      "    this.db = db;",
      "  }",
      "",
      "  /* 绑定动作 submitOrder：状态迁移 */",
      "  @On(event = \"submitOrder\")",
      "  public void onSubmitOrder(SubmitOrderContext context) {",
      "    var order = db.run(Select.from(BOOK_ORDERS).byId(context.getID())).single();",
      "    if (order.getStatus().equals(\"SUBMITTED\")) {",
      "      throw new ServiceException(ErrorStatuses.CONFLICT, \"不能重复提交\");",
      "    }",
      "    db.run(Update.entity(BOOK_ORDERS).byId(order.getID())",
      "           .data(BookOrders.STATUS, \"SUBMITTED\"));",
      "    context.setResult(\"订单 \" + order.getOrderNo() + \" 已提交\");",
      "  }",
      "",
      "  /* before / after 同样是注解 */",
      "  @Before(event = CqnService.EVENT_CREATE, entity = BookOrders_.CDS_NAME)",
      "  public void beforeCreate(CdsCreateEventContext context) { /* ... */ }",
      "}"
    ]
  },
