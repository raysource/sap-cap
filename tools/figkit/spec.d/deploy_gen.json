    "  ]",
    "}",
    "done > wrote output to:",
    "   gen/db/package.json",
    "   gen/db/src/gen/.hdiconfig",
    "   gen/db/src/gen/.hdinamespace",
    "   gen/db/undeploy.json",
    "   ...                    # 每张表/视图一个 .hdbtable / .hdbview 文件"
