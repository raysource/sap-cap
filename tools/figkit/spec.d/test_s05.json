    {"t": "code", "lang": "sql", "fs": 13, "lh": 21, "title": "SQL", "numbers": true, "lines": [
      "SELECT O.\"ORDERNO\", COUNT(I.\"ID\") AS LINES, SUM(I.\"AMOUNT\") AS TOTAL",
      "  FROM \"BOOKORDERS\" O",
      "  JOIN \"BOOKORDERITEMS\" I ON I.\"ORDER_ID\" = O.\"ID\"",
      " GROUP BY O.\"ORDERNO\"",
      " ORDER BY O.\"ORDERNO\";"
