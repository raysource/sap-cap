    {"t": "code", "lang": "sql", "fs": 13, "lh": 21, "title": "SQL", "numbers": true, "lines": [
      "SELECT O.\"ORDERNO\", O.\"CUSTOMER_ID\", COUNT(I.\"ID\") AS LINES, SUM(I.\"AMOUNT\") AS TOTAL",
      "  FROM \"BOOKORDER\".\"BOOK_ORDERS\" O",
      "  JOIN \"BOOKORDER\".\"BOOK_ORDER_ITEMS\" I ON I.\"ORDER_ID\" = O.\"ID\"",
      " GROUP BY O.\"ORDERNO\", O.\"CUSTOMER_ID\"",
      " ORDER BY O.\"ORDERNO\";"
    ]},
